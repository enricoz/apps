# Database
DATABASE_URL=postgresql://user:password@host/database

# Session
SESSION_SECRET=your_random_secret_min_32_chars

# OAuth - Google (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Facebook (optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# OAuth - Microsoft (optional)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# OAuth - Apple (optional)
APPLE_CLIENT_ID=your_apple_service_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key_contents

# Revolut Open Banking (optional)
# Register at https://developer.revolut.com/ for API credentials
REVOLUT_CLIENT_ID=your_revolut_client_id
REVOLUT_PRIVATE_KEY_PATH=./revolut_private_key.pem
# Or inline the private key (for cloud deployments):
# REVOLUT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
REVOLUT_SANDBOX=true

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=/
